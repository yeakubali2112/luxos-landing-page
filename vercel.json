{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "server.js": {
      "includeFiles": "{login.html,admin.html,index.html,data/**,assets/**,favicon.*}"
    }
  },
  "rewrites": [
    { "source": "/api/content", "destination": "/data/content.json" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
